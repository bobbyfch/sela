{
  "id": "./",
  "name": "Sela Books",
  "short_name": "Sela",
  "description": "Open local books, documents and comics with Sela.",
  "start_url": "./?installed=1",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f1eee6",
  "theme_color": "#f1eee6",
  "icons": [
    {
      "src": "../site/icon-192.png?v=0.9.0-beta.8-d5e12de22d9a",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../site/icon-512.png?v=0.9.0-beta.8-2c9c76fd5724",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "../site/icon-maskable-512.png?v=0.9.0-beta.8-2c9c76fd5724",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "books",
          "accept": [
            "application/pdf",
            "application/epub+zip",
            "application/zip",
            "application/vnd.comicbook+zip",
            "text/plain",
            "text/markdown",
            "text/html",
            "application/x-fictionbook+xml",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.oasis.opendocument.text",
            ".pdf",
            ".epub",
            ".cbz",
            ".txt",
            ".md",
            ".html",
            ".htm",
            ".fb2",
            ".docx",
            ".odt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "application/zip": [
          ".epub",
          ".cbz",
          ".docx",
          ".odt"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/x-fictionbook+xml": [
          ".fb2"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ]
      }
    }
  ]
}
