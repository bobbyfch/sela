{
  "id": "./",
  "name": "Sela Books",
  "short_name": "Sela",
  "description": "Your personal reading room on desktop, tablet and phone. Read books, comics and documents.",
  "start_url": "./?installed=1",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#376cda",
  "icons": [
    {
      "src": "../site/icon-192.png?v=0.9.0-beta.4",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../site/icon-512.png?v=0.9.0-beta.4",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "../site/icon-maskable-512.png?v=0.9.0-beta.4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "method": "POST",
    "params": {
      "files": [
        {
          "accept": [
            "application/pdf",
            "application/epub+zip",
            "application/zip",
            "text/plain",
            "text/html",
            ".pdf",
            ".epub",
            ".cbz",
            ".txt",
            ".md",
            ".html",
            ".fb2",
            ".docx",
            ".odt"
          ],
          "name": "books"
        }
      ]
    },
    "enctype": "multipart/form-data",
    "action": "./share"
  },
  "file_handlers": [
    {
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/xml": [
          ".fb2"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/zip": [
          ".cbz"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ]
      },
      "action": "./"
    }
  ]
}
