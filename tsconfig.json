{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*.ts",
    "app/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "examples/web-component.ts",
    "astro.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "app/mobile/sw.ts",
    "app/site/viewer-sw.ts"
  ]
}
