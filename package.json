{
  "name": "@bobbyfch/sela",
  "version": "0.9.0-beta.8",
  "description": "Local-first personal reader with source-aware open-book discovery, a private bookshelf, and a framework-independent document viewer",
  "type": "module",
  "imports": {
    "#components/*": "./ui/components/*.tsx",
    "#ui/*": "./ui/components/ui/*.tsx",
    "#lib/*": "./ui/lib/*.ts",
    "#hooks/*": "./ui/hooks/*.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobbyfch/sela.git"
  },
  "homepage": "https://bobbyfch.github.io/sela/",
  "bugs": {
    "url": "https://github.com/bobbyfch/sela/issues"
  },
  "keywords": [
    "ebook-reader",
    "personal-library",
    "epub",
    "pdf-reader",
    "local-first",
    "web-reader"
  ],
  "main": "./dist/js/sela.esm.js",
  "module": "./dist/js/sela.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/sela.esm.js",
      "default": "./dist/js/sela.esm.js"
    },
    "./css": "./dist/css/sela.min.css",
    "./vue": "./adapters/vue/SelaViewer.vue",
    "./dist/*": "./dist/*",
    "./host": {
      "types": "./dist/types/host-integration.d.ts",
      "import": "./dist/js/sela.host.js"
    },
    "./scriptures": {
      "types": "./dist/types/scriptures.d.ts",
      "import": "./dist/js/sela.scriptures.js"
    }
  },
  "files": [
    "dist",
    "adapters",
    "licenses",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "test:types": "node node_modules/typescript/bin/tsc -p tests/types/tsconfig.json",
    "check:foundation": "npm run typecheck",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "build:story": "python scripts/build-story.py",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc -p tsconfig.worker.json && node node_modules/typescript/bin/tsc -p tsconfig.tests.json && node node_modules/typescript/bin/tsc -p tsconfig.foundation.json && node node_modules/typescript/bin/tsc -p tsconfig.ui.json",
    "profile": "node --experimental-strip-types scripts/profile.ts",
    "screenshots": "node --experimental-strip-types scripts/capture-product.ts",
    "test:frameworks": "node --experimental-strip-types scripts/framework-matrix.ts && node --experimental-strip-types scripts/component-matrix.ts && node --experimental-strip-types scripts/php-host-matrix.ts"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.64.1",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "6.4.299",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "sharp": "0.35.5",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vite": "8.3.4",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "@mantine/carousel": "^9.7.3",
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/dropzone": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@mantine/spotlight": "^9.7.3",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@react-three/drei": "^10.7.9",
    "dayjs": "^1.11.23",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "radix-ui": "^1.8.1"
  }
}
