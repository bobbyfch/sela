{
  "name": "@bobbyfch/sela",
  "version": "0.9.0-beta.2",
  "description": "Sela personal reader with a cozy local-first bookshelf and lightweight framework-independent document viewer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobbyfch/sela.git"
  },
  "main": "./dist/js/sela.esm.js",
  "module": "./dist/js/sela.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/sela.esm.js",
      "default": "./dist/js/sela.esm.js"
    },
    "./css": "./dist/css/sela.min.css",
    "./vue": "./adapters/vue/SelaViewer.vue",
    "./dist/*": "./dist/*",
    "./host": {
      "types": "./dist/types/host-integration.d.ts",
      "import": "./dist/js/sela.host.js"
    }
  },
  "files": [
    "dist",
    "adapters",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "test:types": "node node_modules/typescript/bin/tsc -p tests/types/tsconfig.json",
    "check:foundation": "npm run typecheck",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "build:story": "python scripts/build-story.py",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc -p tsconfig.worker.json && node node_modules/typescript/bin/tsc -p tsconfig.tests.json && node node_modules/typescript/bin/tsc -p tsconfig.foundation.json && node node_modules/typescript/bin/tsc -p tsconfig.ui.json",
    "profile": "node --experimental-strip-types scripts/profile.ts",
    "screenshots": "node --experimental-strip-types scripts/capture-product.ts",
    "test:frameworks": "node --experimental-strip-types scripts/framework-matrix.ts && node --experimental-strip-types scripts/component-matrix.ts && node --experimental-strip-types scripts/php-host-matrix.ts"
  },
  "devDependencies": {
    "@astrojs/react": "7.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.3.8",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vite": "8.3.4",
    "vue": "3.5.43"
  }
}
